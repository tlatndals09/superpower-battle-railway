<script>
const $=id=>document.getElementById(id);
const FLEX={duel:'flex'};
function go(id){document.querySelectorAll('.scr').forEach(e=>e.style.display='none');$(id).style.display=FLEX[id]||'flex';
 $('codeTag').style.display=(id==='wait')?'block':'none';}
go('menu');
$('startBtn').onclick=()=>{$('msg').textContent='';go('codeScr')};
$('skillBack').onclick=()=>go('menu');
$('codeBack').onclick=()=>go('menu');

/* ================= 게임 상수 ================= */
const W=400,BH=300,CH=20,TOP_Y=60,BOT_Y=560,VH=980;   // 가상 좌표(캔버스 400\times980)
const SPEED=W/1.7;            // 네모칸 한쪽 끝→끝 1.7초
const PSPEED=VH/3;            // 스킬 속도: 화면 위아래 끝에서 끝까지 편도 3초
const DMG_PER_PIXEL=3;
const HEAL_EN=30,HEAL_CD=20,HEAL_AMT=10;
const TP_EN=40,TP_CD=20,TP_DIST=4*CH;
const ULT_MAX=100,CLOAK_MS=5000,FREEZE_MS=3000,SUMMON_SHOTS=20,SUMMON_GAP=500;
const ROLL_EN=20,ROLL_CD=10,ROLL_DIST=3*CH;   // 구르기 기력/쿨타임은 지정이 없어서 임시값
const SLOT_IDS=['J','K','L','S'], SLOT_LAB=['J','K','L',';'];
const KEYMAP={KeyJ:'J',KeyK:'K',KeyL:'L',Semicolon:'S',Digit8:'8',Digit9:'9',Digit0:'0',Numpad8:'8',Numpad9:'9',Numpad0:'0',KeyP:'P'};
const ONE='0'.repeat(40)+'1'+'0'.repeat(40);
const MOVEKEYS=new Set(['KeyW','KeyA','KeyS','KeyD']);

/* ================= 스킬 계산 ================= */
function cnt(s){let n=0;for(let i=0;i<s.length;i++)if(s[i]==='1')n++;return n}
function costOf(n){return 5+Math.max(0,n-3)}
function cdOf(n){return Math.round((1+0.2*Math.max(0,n-3))*10)/10}
function fmt(x){return String(x).replace(/\.0$/,'')}
function validSkill(s){return typeof s==='string'&&/^[01]{81}$/.test(s)&&s.indexOf('1')>=0}
function cellsOf(s){let minc=9,maxc=-1,maxr=-1;const a=[];
 for(let i=0;i<81;i++)if(s[i]==='1'){const c=i%9,r=(i/9)|0;a.push([c,r]);if(c<minc)minc=c;if(c>maxc)maxc=c;if(r>maxr)maxr=r}
 return a.map(([c,r])=>({ox:(c-(minc+maxc)/2)*CH,oy:(r-maxr)*CH-CH/2,dead:false}))}

/* ================= 저장 데이터: 스킬 목록 + 4개 슬롯 ================= */
let skills=[],slots=['','','',''],actSlot=-1,delSk=null;
try{
 const raw=JSON.parse(localStorage.getItem('skills')||'[]');
 skills=(Array.isArray(raw)?raw:[]).filter(validSkill);
 const rs=JSON.parse(localStorage.getItem('slots')||'null');
 if(Array.isArray(rs))slots=[0,1,2,3].map(i=>skills.includes(rs[i])?rs[i]:'');
 else{const old=localStorage.getItem('skillSel');if(old&&skills.includes(old))slots[0]=old}
}catch(e){}
let ult='';
try{const ru=localStorage.getItem('ult');if(ru==='cloak'||ru==='freeze'||ru==='summon')ult=ru}catch(e){}
function persist(){try{localStorage.setItem('skills',JSON.stringify(skills));localStorage.setItem('slots',JSON.stringify(slots));localStorage.setItem('ult',ult)}catch(e){}}

/* ================= 스킬 설정 화면 ================= */
function thumb(str){const c=document.createElement('canvas');c.width=c.height=72;const k=c.getContext('2d');k.fillStyle='#222';k.fillRect(0,0,72,72);
 if(str){k.fillStyle='#fff';for(let n=0;n<81;n++)if(str[n]==='1')k.fillRect((n%9)*8,((n/9)|0)*8,8,8)}
 else{k.fillStyle='#777';k.font='13px sans-serif';k.textAlign='center';k.textBaseline='middle';k.fillText('비어 있음',36,36)}
 return c}
function setMsg(t){$('setmsg').textContent=t||''}
function buildSlots(){const h=$('slots');h.innerHTML='';
 SLOT_LAB.forEach((lab,i)=>{const s=slots[i];const w=document.createElement('div');w.className='slot'+(actSlot===i?' sel':'');
  const t=document.createElement('div');t.className='sk';t.textContent=lab;w.appendChild(t);
  w.appendChild(thumb(s));
  if(s){const b=document.createElement('button');b.textContent='빼기';b.onclick=ev=>{ev.stopPropagation();slots[i]='';persist();setMsg('');buildSlots();buildSkills()};w.appendChild(b)}
  w.onclick=()=>{actSlot=(actSlot===i?-1:i);setMsg('');buildSlots()};
  h.appendChild(w)})}
function assign(str){
 const at=slots.indexOf(str);
 if(actSlot>=0){
  if(at===actSlot){slots[at]=''}
  else{if(at>=0)slots[at]='';slots[actSlot]=str}
  actSlot=-1;
 }else if(at>=0){slots[at]='';setMsg('')}
 else{const t=slots.indexOf('');if(t<0){setMsg('슬롯 4개가 가득 찼어요. 슬롯을 먼저 고르거나 빼기를 눌러 주세요');return}slots[t]=str;setMsg('')}
 persist();buildSlots();buildSkills()}
function buildSkills(){const h=$('sgrid');h.innerHTML='';
 if(!skills.length){h.textContent='저장한 스킬이 없어요. 스킬 커스텀에서 그려서 저장해 보세요.';return}
 skills.forEach((str,i)=>{const at=slots.indexOf(str);const w=document.createElement('div');w.className='sitem'+(at>=0?' sel':'');
  w.appendChild(thumb(str));
  const l=document.createElement('div');l.textContent=at>=0?'✔ '+SLOT_LAB[at]:'#'+(i+1);w.appendChild(l);
  const n=cnt(str),st=document.createElement('div');st.className='st';st.textContent=n+'칸 · 마나 '+costOf(n)+' · 쿨 '+fmt(cdOf(n))+'초';w.appendChild(st);
  const d=document.createElement('button');const armed=delSk===str;d.textContent=armed?'정말 삭제?':'삭제';
  d.style.cssText='margin-top:4px;font-size:12px;padding:4px 8px;border:0;border-radius:6px;color:#fff;background:'+(armed?'#e02020':'#444');
  d.onclick=ev=>{ev.stopPropagation();if(delSk===str){skills=skills.filter(x=>x!==str);slots=slots.map(x=>x===str?'':x);delSk=null;persist();buildSlots();}else delSk=str;buildSkills()};
  w.appendChild(d);w.onclick=()=>{delSk=null;assign(str)};h.appendChild(w);});}
const ULTS={
 cloak:{n:'암막',d:'5초간 상대 화면에서 상대 네모칸 바깥이 전부 안 보여요. 상대 스킬은 내 네모칸 안으로 들어와야 보여요. 대신 나는 5초간 상대 캐릭터가 안 보여요(스킬은 보여요).'},
 freeze:{n:'고정',d:'상대를 그 자리에서 3초간 못 움직이게 해요.'},
 summon:{n:'소환',d:'10초 동안 초당 2발, 내 네모칸 안 랜덤 위치에서 1픽셀 공격이 나가요.'}};
function buildUlts(){const h=$('ults');h.innerHTML='';
 Object.keys(ULTS).forEach(k=>{const b=document.createElement('button');b.className='tb'+(ult===k?' on':'');b.textContent=ULTS[k].n;
  b.onclick=()=>{ult=(ult===k?'':k);persist();buildUlts()};h.appendChild(b)});
 $('ultDesc').textContent=Object.keys(ULTS).map(k=>ULTS[k].n+': '+ULTS[k].d).join('\n')+'\n\n'+(ult?'선택됨: '+ULTS[ult].n:'선택 안 함 (P키를 눌러도 아무 일도 안 일어나요)')}
$('skillSetBtn').onclick=()=>{delSk=null;actSlot=-1;setMsg('');buildSlots();buildUlts();buildSkills();go('skillSet')};
$('skillSetBack').onclick=()=>go('menu');

/* ================= 스킬 그리기: 9\times9 ================= */
const SN=9,scv=$('scv'),sc=scv.getContext('2d');
let smode=1,sg=new Array(SN*SN).fill(0),sundo=[],erase=false,sdraw_=false,slp=null,scell=32;
function sdraw(){sc.fillStyle='#222';sc.fillRect(0,0,scv.width,scv.height);sc.fillStyle='#fff';
 for(let i=0;i<sg.length;i++)if(sg[i])sc.fillRect((i%SN)*scell,((i/SN)|0)*scell,scell,scell);
 sc.strokeStyle='#555';sc.lineWidth=1;sc.beginPath();
 for(let k=0;k<=SN;k++){sc.moveTo(k*scell+.5,0);sc.lineTo(k*scell+.5,SN*scell);sc.moveTo(0,k*scell+.5);sc.lineTo(SN*scell,k*scell+.5);}sc.stroke();}
function sput(x,y){if(x>=0&&y>=0&&x<SN&&y<SN)sg[y*SN+x]=smode}
function sstroke(e){const r=scv.getBoundingClientRect(),x=Math.floor((e.clientX-r.left)/r.width*SN),y=Math.floor((e.clientY-r.top)/r.height*SN);
 if(slp){const n=Math.max(Math.abs(x-slp[0]),Math.abs(y-slp[1]),1);for(let i=0;i<=n;i++)sput(Math.round(slp[0]+(x-slp[0])*i/n),Math.round(slp[1]+(y-slp[1])*i/n));}else sput(x,y);
 slp=[x,y];sdraw();}
scv.onpointerdown=e=>{scv.setPointerCapture(e.pointerId);sundo.push(sg.slice());if(sundo.length>100)sundo.shift();slp=null;sdraw_=true;$('smsg').textContent='';
 const r0=scv.getBoundingClientRect(),cx0=Math.floor((e.clientX-r0.left)/r0.width*SN),cy0=Math.floor((e.clientY-r0.top)/r0.height*SN);
 smode=(erase||(cx0>=0&&cy0>=0&&cx0<SN&&cy0<SN&&sg[cy0*SN+cx0]))?0:1;
 sstroke(e)};
scv.onpointermove=e=>{if(sdraw_)sstroke(e)};
scv.onpointerup=scv.onpointercancel=()=>{sdraw_=false;slp=null};
function sTools(){$('skillEraser').classList.toggle('on',erase)}
$('skillEraser').onclick=()=>{erase=!erase;sTools()};
$('skillUndo').onclick=()=>{if(sundo.length){sg=sundo.pop();sdraw()}};
$('skillSave').onclick=()=>{const str=sg.join('');if(!sg.some(v=>v)){$('smsg').textContent='그림이 비어 있어요!';return}
 skills=skills.filter(x=>x!==str);skills.unshift(str);skills=skills.slice(0,30);
 slots=slots.map(x=>skills.includes(x)?x:'');
 let extra='';const e=slots.indexOf('');if(e>=0&&!slots.includes(str)){slots[e]=str;extra=' · '+SLOT_LAB[e]+' 슬롯에 넣었어요'}
 persist();$('smsg').textContent='저장했어요'+extra+' (스킬 설정에서 바꿀 수 있어요)'};
$('skillBtn').onclick=()=>{sg=new Array(SN*SN).fill(0);sundo=[];erase=false;sTools();$('smsg').textContent='';
 scell=Math.max(16,Math.min(44,Math.floor((innerWidth-40)/SN),Math.floor((innerHeight-230)/SN)));
 scv.width=scv.height=SN*scell;scv.style.width=scv.style.height=SN*scell+'px';go('skillScr');sdraw();};

/* ================= 온라인: 방 만들기 / 입장 ================= */
$('code').oninput=e=>{e.target.value=e.target.value.replace(/[^A-Za-z0-9]/g,'').toUpperCase().slice(0,4)};
function randCode(){const c='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<4;i++)s+=c[Math.floor(Math.random()*c.length)];return s}
let named=null,off=null,G=null,raf=0,lastT=0;
function pres(o){try{const p=named&&named.presence(o);if(p&&p.catch)p.catch(()=>{})}catch(e){}}
async function leave(){G=null;$('exitBtn').style.display='none';if(off){off();off=null}if(named){try{await named.leave()}catch(e){}named=null}}
$('leaveBtn').onclick=async()=>{await leave();go('codeScr')};
$('exitBtn').onclick=async()=>{await leave();go('menu')};
function createRoomTransport(){
 return {join:(roomName,mode)=>new Promise((resolve,reject)=>{
  let settled=false,peerId='',peers=[],selfPresence={};
  const listeners=new Set();
  const socket=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws');
  const notify=()=>listeners.forEach(fn=>{try{fn()}catch(e){}});
  const setPeers=list=>{
   peers=(Array.isArray(list)?list:[]).filter(p=>p&&typeof p.peer==='string').map(p=>({
    peer:p.peer,kind:'viewer',isMe:p.peer===peerId,sameTab:p.peer===peerId,presence:p.presence&&typeof p.presence==='object'?p.presence:{}
   }));
   const self=peers.find(p=>p.isMe);if(self)self.presence={...self.presence,...selfPresence};
   notify();
  };
  const named={
   get isConnected(){return socket.readyState===WebSocket.OPEN&&!!peerId},
   peers:()=>peers,
   presence:data=>{
    if(!data||typeof data!=='object')return;
    selfPresence={...selfPresence,...data};
    const self=peers.find(p=>p.isMe);if(self)self.presence={...self.presence,...data};
    notify();
    if(socket.readyState===WebSocket.OPEN)socket.send(JSON.stringify({type:'presence',data}));
   },
   onPeers:fn=>{listeners.add(fn);return()=>listeners.delete(fn)},
   leave:async()=>{
    if(socket.readyState===WebSocket.OPEN)socket.send(JSON.stringify({type:'leave'}));
    socket.close();peers=[];notify();
   }
  };
  const timer=setTimeout(()=>{if(!settled){settled=true;reject(new Error('connection-timeout'));socket.close()}},8000);
  socket.onopen=()=>socket.send(JSON.stringify({type:'join',room:roomName,mode}));
  socket.onmessage=event=>{
   let message;try{message=JSON.parse(event.data)}catch(e){return}
   if(message.type==='join-error'){
    clearTimeout(timer);if(!settled){settled=true;reject(new Error(message.code||'connection-failed'))}return;
   }
   if(message.type==='joined'){
    peerId=message.peer;setPeers(message.peers);clearTimeout(timer);
    if(!settled){settled=true;resolve(named)}return;
   }
   if(message.type==='peers')setPeers(message.peers);
  };
  socket.onerror=()=>{};
  socket.onclose=()=>{
   clearTimeout(timer);
   if(!settled){settled=true;reject(new Error('connection-failed'))}
   else{peers=[];notify()}
  };
 })}
}
