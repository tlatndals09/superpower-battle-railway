<title>초능력 대전</title>
<style>
html,body{height:100%;margin:0;background:#000;color:#fff;font-family:system-ui,-apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
.scr{display:none;height:100%;box-sizing:border-box}
.center{flex-direction:column;align-items:center;justify-content:center;gap:18px}
h1{font-size:34px;margin:0 0 14px}
button{background:none;color:#fff;border:2px solid #fff;border-radius:10px;font-size:22px;padding:12px 40px;font-family:inherit;cursor:pointer}
button.small{font-size:15px;padding:6px 18px;border-color:#888;color:#ccc}
.row{display:flex;align-items:center;gap:12px;font-size:22px}
input{background:#000;color:#fff;border:2px solid #fff;border-radius:8px;font-size:24px;width:4.6em;padding:8px;text-align:center;letter-spacing:.2em;text-transform:uppercase;font-family:inherit}
#msg{min-height:20px;color:#ffe14a;font-size:14px;text-align:center;max-width:320px}
#codeTag{display:none;position:fixed;z-index:5;top:calc(env(safe-area-inset-top,0px) + 16px);left:20px;font-size:20px;font-weight:700;letter-spacing:.15em}
#duel{position:relative;align-items:center;justify-content:center}
#cv{display:block}
